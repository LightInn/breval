		"test:cms": "node --import tsx --test tests/cms.integration.ts",
		"cms:export": "node scripts/export-strapi.mjs",
		"cms:migrate": "payload migrate",
		"test:e2e": "playwright test",
		"test:i18n": "node --import tsx --test tests/i18n.integration.ts",
		"start:production": "pnpm cms:migrate && next start",
		"test:serverless": "node --import tsx --test tests/serverless.integration.ts",
		"check:complexity": "node scripts/check-complexity.mjs"
	},
