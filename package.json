{
	"name": "breval",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"turbo": "next dev --turbopack",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"husky": "husky install",
		"test": "jest",
		"test:watch": "jest --watch",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
