# Local development: SQLite and local media; do not set S3_* variables.
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=file:./.data/payload.db
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production: PostgreSQL + Cloudflare R2 (replace all placeholders).
# DATABASE_URL=postgresql://user:percent-encoded-password@host:5432/database
# NEXT_PUBLIC_SITE_URL=https://brev.al
# S3_BUCKET=breval
# S3_ACCESS_KEY_ID=
# S3_ACCESS_SECRET=
# S3_ENDPOINT=https://account-id.eu.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://cdn.brev.al

# Only for one-time administrator creation with scripts/seed-cms.ts:
# PAYLOAD_ADMIN_EMAIL=
# PAYLOAD_ADMIN_PASSWORD=
