{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"],
			"@payload-config": ["./src/payload.config.ts"]
		},
		"strict": false,
		"incremental": true,
		"isolatedModules": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"next-env.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"scripts/**/*.ts",
		"tests/cms.integration.ts",
		"playwright.config.ts",
		"e2e/**/*.ts",
		"tests/i18n.integration.ts",
		"tests/serverless.integration.ts"
	],
	"exclude": ["node_modules"]
}
